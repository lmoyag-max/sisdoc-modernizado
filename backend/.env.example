# ══════════════════════════════════════════════════════
# DOC360 Backend — Variables de entorno
# Copiar como .env y completar con valores reales.
# NUNCA commitear el .env real.
# ══════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001

# ── Base de datos SQL Server ───────────────────────────
# Usar usuario de aplicación (doc360_app), NO sa.
# doc360_app necesita: db_owner en SISDOC. No requiere sysadmin.
DB_USER=doc360_app
DB_PASSWORD=change_me
DB_SERVER=localhost
# Nota: puerto 1433 está reservado por Windows/Hyper-V.
# Docker mapea 127.0.0.1:11433:1433 en docker-compose.yml.
DB_PORT=11433
DB_DATABASE=SISDOC
DB_TRUST_CERT=true
DB_ENCRYPT=false
# En producción: DB_ENCRYPT=true, DB_TRUST_CERT=false + certificado válido

# URL alternativa (usada por herramientas de diagnóstico)
DATABASE_URL="sqlserver://localhost:11433;database=SISDOC;user=doc360_app;password=change_me;encrypt=false;trustServerCertificate=true"

# ── JWT ────────────────────────────────────────────────
# Generar secretos con: openssl rand -base64 64
# Mínimo 512 bits (88 chars en base64). CAMBIAR antes de producción.
JWT_SECRET=replace_with_512bit_random_base64_string
JWT_REFRESH_SECRET=replace_with_different_512bit_random_base64_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────
# Separar múltiples orígenes con coma
CORS_ORIGIN=http://localhost:5173

# ── Archivos ───────────────────────────────────────────
UPLOAD_DIR=./uploads
# Hardcap multer en bytes (20 MB = 20971520). La UI solo puede restringir
# por debajo de este valor, nunca superarlo.
MAX_FILE_SIZE=20971520

# ── Recuperación de contraseña por email ──────────────
# Configurar con los datos del servidor SMTP real.
# Para pruebas: Mailtrap (https://mailtrap.io) o Ethereal (https://ethereal.email)
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=change_me
SMTP_FROM=DOC360 <noreply@example.com>
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRES_MINUTES=30
